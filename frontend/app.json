{
  "expo": {
    "name": "frontend",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#050A10"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.nesusettlement.yi1h2n",
      "infoPlist": {
        "NSPhotoLibraryAddUsageDescription": "Save your pledge certificate to Photos"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#050A10"
      },
      "package": "com.emergent.nesusettlement.yi1h2n"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "cover",
          "backgroundColor": "#050A10",
          "enableFullScreenImage_legacy": true
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "expo-video",
      "expo-sharing",
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Save your pledge certificate to Photos",
          "photosPermission": "Save your pledge certificate to Photos"
        }
      ],
      "@react-native-vector-icons/ionicons"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
